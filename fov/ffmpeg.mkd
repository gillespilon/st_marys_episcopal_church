"drawtext=fontfile=/usr/share/fonts/TTF/DejaVuSans.ttf:text='Sunday, March 29, 2026':fontcolor=blue:fontsize=24:box=1:boxcolor=white:x=(w-text_w)/2:y=h-120:enable='between(t,0,5)', \
